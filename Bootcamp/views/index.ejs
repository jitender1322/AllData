<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Express server</h1>
    <form action="/addData" method="post" enctype="multipart/form-data">
        <input type="text" placeholder="Enter your name" name="name">
        <input type="text" placeholder="Enter your age" name="age">
        <input type="text" placeholder="Enter your city" name="city">
        <input type="file" name="image">
        <button type="submit">Add Data</button>
    </form>
    <table border="1" width="70%">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Age</th>
                <th>City</th>
                <th>Image</th>
                <th colspan="2">Action</th>
            </tr>
        </thead>
        <tbody>
            <%data.map((e,i)=>{%>
                <tr>
                    <td><%=e.id%></td>
                    <td><%=e.name%></td>
                    <td><%=e.age%></td>
                    <td><%=e.city%></td>
                    <td><img src="<%=e.image%>" width="20%" alt=""></td>
                    <td><a href=""><button>Edit</button></a></td>
                    <td><a href=""><button>Delete</button></a></td>
                </tr>
            <%})%>
        </tbody>
    </table>
</body>
</html>