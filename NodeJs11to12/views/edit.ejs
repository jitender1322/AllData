<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>CRUD with Mongo</h1>

    <form action="/updateData?id=<%=e.id%>" method="post">
        <input type="text" value="<%=singleData.id%>" hidden name="id">
        <input type="text" value="<%=singleData.name%>" placeholder="Enter your name" name="name">
        <input type="number" value="<%=singleData.age%>" placeholder="Enter your age" name="age">
        <input type="submit" value="Update">
    </form>

</body>
</html>