<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>CRUD with Mongo</h1>

    <form action="/addData" method="post">
        <input type="text" placeholder="Enter your name" name="name">
        <input type="number" placeholder="Enter your age" name="age">
        <input type="submit">
    </form>

    <table border="1" width="100%">
        <tr>
            <td>Id</td>
            <td>Name</td>
            <td>Age</td>
            <td colspan="2">Actions</td>
        </tr>
        <%data.map((e,i)=>{%>
            <tr>
                <td><%=e.id%></td>
                <td><%=e.name%></td>
                <td><%=e.age%></td>
                <td><a href="/editData?id=<%=e.id%>"><button>Edit</button></a></td>
                <td><a href="/deleteData?id=<%=e.id%>"><button>Delete</button></a></td>
            </tr>
        <%})%>
    </table>
</body>
</html>